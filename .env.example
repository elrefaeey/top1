# انسخ إلى .env محلياً | وعلى Vercel أضف نفس المفاتيح في Project → Settings → Environment Variables

# ═══════════════════════════════════════════════════════════
# REQUIRED — بدونها الموقع أو النماذج/الـ Admin لا يعملان
# ═══════════════════════════════════════════════════════════

# Firebase Web (عميل + سيرفر) — تُضمَّن في bundle المتصفح (عامة حسب تصميم Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Measurement ID للـ Analytics (يمكن تركه فارغاً إذا عطّلت Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# رابط الموقع العام — canonical / sitemap / OG
# محلي: http://localhost:8080
VITE_SITE_URL=https://www.top1markting.com

# Service Account JSON في سطر واحد — سيرفر فقط — مطلوب لـ /api/leads
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# ═══════════════════════════════════════════════════════════
# RECOMMENDED على Vercel (إنتاج متعدد الـ instances)
# ═══════════════════════════════════════════════════════════

# Upstash Redis REST — rate limit موزّع لـ leads / upload / APIs
# بدونها: حد معدّل داخل الذاكرة لكل instance فقط
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ═══════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════

VITE_GTM_ID=
VITE_GSC_VERIFICATION=

# Google Search Console OAuth (سيرفر فقط — لا تضع Client Secret في VITE_*)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# خاصية الموقع في Search Console (يجب أن تطابق الـ property حرفياً)
GSC_SITE_URL=https://www.top1markting.com/
# اختياري: إن تُرك فارغاً يُشتق من Origin الطلب → /api/seo/gsc/callback
# GSC_REDIRECT_URI=https://www.top1markting.com/api/seo/gsc/callback

# مفتاح أتمتة SEO (سيرفر فقط) — لـ Cursor Automation / AI agent
# يُرسل في الهيدر: x-seo-automation-key
# بديل عن توكن محرر Firebase لـ /api/seo/*
SEO_AUTOMATION_API_KEY=

# AI SEO Growth Engine (سيرفر فقط — لا تضع المفاتيح في VITE_*)
# اختر مزوداً أو اتركه فارغاً للاختيار التلقائي: openai إن وُجد المفتاح، ثم anthropic، وإلا قالب عربي محلي
# SEO_AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# بديل رفع الصور إن فشل Firebase Storage
IMGBB_API_KEY=

# ═══════════════════════════════════════════════════════════
# Hostinger / Node فقط (ليس مطلوباً على Vercel)
# ═══════════════════════════════════════════════════════════
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
