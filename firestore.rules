rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() &&
        userDoc().data.role == 'admin';
    }

    function isEditor() {
      return isSignedIn() &&
        userDoc().data.role in ['admin', 'editor'];
    }

    // User profiles — الإنشاء والصلاحيات بواسطة admin فقط
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['role', 'email', 'createdAt']) &&
        request.resource.data.role in ['admin', 'editor'];
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.keys().hasOnly(['role', 'email', 'createdAt'])
      );
      allow delete: if isAdmin();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    function isPublicContent() {
      return !('status' in resource.data) ||
        resource.data.status == null ||
        resource.data.status == 'published';
    }

    match /pages/{docId} {
      allow read: if isPublicContent() || isEditor();
      allow write: if isEditor();
    }

    match /services/{docId} {
      allow read: if isPublicContent() || isEditor();
      allow write: if isEditor();
    }

    match /portfolio/{docId} {
      allow read: if isPublicContent() || isEditor();
      allow write: if isEditor();
    }

    match /blog_posts/{docId} {
      allow read: if isPublicContent() || isEditor();
      allow write: if isEditor();
    }

    match /blog_categories/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /blog_tags/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /testimonials/{docId} {
      allow read: if isPublicContent() || isEditor();
      allow write: if isEditor();
    }

    match /authors/{docId} {
      allow read: if isPublicContent() || isEditor();
      allow write: if isEditor();
    }

    match /pricing_plans/{docId} {
      allow read: if isPublicContent() || isEditor();
      allow write: if isEditor();
    }

    match /faqs/{docId} {
      allow read: if isPublicContent() || isEditor();
      allow write: if isEditor();
    }

    match /site_stats/{docId} {
      allow read: if isEditor() || isPublicContent();
      allow write: if isEditor();
    }

    match /media/{docId} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.data.keys().hasAll(['contentType', 'dataBase64', 'folder', 'size', 'createdAt'])
        && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.data.dataBase64 is string
        && request.resource.data.dataBase64.size() < 900000
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size < 620000;
      allow update, delete: if isEditor();
    }

    match /leads/{docId} {
      allow create: if false;
      allow read, update, delete: if isEditor();
    }

    // AI SEO Growth — client cannot create/delete; Admin REST (service account) bypasses rules.
    // Editors may read for Admin SEO AI UI; insights status can be updated for workflow.
    match /seo_insights/{docId} {
      allow read: if isEditor();
      allow create, delete: if false;
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'reviewed', 'completed'];
    }

    match /gsc_snapshots/{docId} {
      allow read: if isEditor();
      allow create, update, delete: if false;
    }

    match /ai_logs/{docId} {
      allow read: if isEditor();
      allow create, update, delete: if false;
    }

    // GSC OAuth credentials — refresh tokens.
    // Admin may read/write ONLY their own doc (docId == auth.uid). No public access.
    // Service account (Admin REST) still bypasses rules when configured.
    match /gsc_credentials/{userId} {
      allow read: if isAdmin() && request.auth.uid == userId;
      allow create, update: if isAdmin()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'refreshToken', 'connectedEmail', 'createdAt', 'updatedAt'])
        && request.resource.data.refreshToken is string
        && request.resource.data.refreshToken.size() > 0
        && request.resource.data.connectedEmail is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
